<%# Icons for the FreeBMD1 entry symbols, driven by the BestGuess Confirmed bits in the search snapshot %>
<% is_new = @search_query.bmd_snapshot_flag?(search_record, BestGuess::ENTRY_NEW) %>
<% has_postem = @search_query.bmd_snapshot_has_postem?(search_record) %>
<% has_comment = @search_query.bmd_snapshot_flag?(search_record, BestGuess::ENTRY_COMMENT) %>
<% has_reference = @search_query.bmd_snapshot_flag?(search_record, BestGuess::ENTRY_REFERENCE) %>
<% is_system = @search_query.bmd_snapshot_flag?(search_record, BestGuess::ENTRY_SYSTEM) %>
<%# Most entries are double keyed, so only flag the ones that are not %>
<% unconfirmed = !@search_query.bmd_snapshot_flag?(search_record, BestGuess::ENTRY_CONFIRMED) %>
<% if unconfirmed || is_new || has_postem || has_comment || has_reference || is_system %>
  <% details_url = friendly_bmd_record_details_path(@search_query.id, search_record.RecordNumber, search_record.friendly_url, record_hash: search_record.record_hash) %>
  <div class="bmd-flags">
    <% if unconfirmed %>
      <span title="Unconfirmed: transcribed once only, not yet confirmed by a second transcriber">
        <span class="accessibility">Unconfirmed: transcribed once only, not yet confirmed by a second transcriber</span>
        <i class="fas fa-user bmd-flag" aria-hidden="true"></i>
      </span>
    <% end %>
    <% if is_new %>
      <span class="bmd-flag bmd-flag--label" title="New or changed since the previous database update">New</span>
    <% end %>
    <% if has_postem %>
      <a href="<%= "#{details_url}#postems" %>" title="Postem available">
        <span class="accessibility">Postem available</span>
        <%= app_icons[:postem].html_safe %>
      </a>
    <% end %>
    <% if has_comment %>
      <a href="<%= "#{details_url}#comments" %>" title="Transcriber's comment">
        <span class="accessibility">Transcriber's comment</span>
        <i class="fas fa-comment bmd-flag" aria-hidden="true"></i>
      </a>
    <% end %>
    <% if has_reference %>
      <a href="<%= "#{details_url}#linked-records" %>" title="Linked record, such as a late registration">
        <span class="accessibility">Linked record, such as a late registration</span>
        <i class="fas fa-link bmd-flag" aria-hidden="true"></i>
      </a>
    <% end %>
    <% if is_system %>
      <a href="<%= details_url %>" title="System entry: added to correct an apparent error in the GRO index">
        <span class="accessibility">System entry: added to correct an apparent error in the GRO index</span>
        <i class="fas fa-bolt bmd-flag" aria-hidden="true"></i>
      </a>
    <% end %>
  </div>
<% end %>
