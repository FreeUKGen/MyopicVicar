<section>
  <div id="compact_text_citation_container" style="display: none;">
    <% @entry = entry %>
    <h4>Compact text (FreeBMD1 style):</h4>
    <% marriage_submission = @entry.post_1994_marriage? ? @entry.get_submission : nil %>
    <p class = "citation_container"><%= format_record_type_for_scan_url(@entry)%>s&#9;<%= compact_text_date(@entry) %><br/>
      <%= @entry['Surname'] %>&#9;<%= @entry['GivenName'] %>&#9;<%= @entry['AssociateName'] %>&#9;<%= @entry['AgeAtDeath'] %>&#9;<%=@entry['District']%>&#9;<%=@entry['Volume']%>&#9;<% if @entry.register_entry_number_format %><%= @entry.event_registration_number %> <%= @entry.event_entry_number %><% else %><%=@entry['Page']%><% end %><% if marriage_submission.present? %>&#9;<%= marriage_submission.EntryNumber %>&#9;<%= marriage_submission.SourceCode %><% end %>
    </p>
  <div class = "text--center">
    <button class = "btn  btn--small ", onclick = copy("compact_text_citation_container") style = "cursor: pointer">Copy</button>
    <button class = "btn  btn--small ", onclick = this.parentElement.parentElement.style.display='none' style = "cursor: pointer">Close</button>
  </div>
  </div>
</section>